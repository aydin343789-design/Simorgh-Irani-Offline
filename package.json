{
  "name": "simorgh-irani-translator",
  "version": "1.3.0",
  "private": true,
  "scripts": {
    "prepare:tts": "python3 scripts/prepare-tts-models.py",
    "prepare:apk": "node scripts/prepare-apk.mjs",
    "sync": "npm run prepare:tts && npm run prepare:apk && npx cap sync android",
    "build:android": "npm run sync && cd android && ./gradlew --no-daemon assembleDebug"
  },
  "dependencies": {
    "@capacitor/android": "^7.0.0",
    "@capacitor/core": "^7.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.0.0",
    "acorn": "^8.18.0",
    "javascript-obfuscator": "^5.8.0",
    "typescript": "^7.0.2"
  }
}
